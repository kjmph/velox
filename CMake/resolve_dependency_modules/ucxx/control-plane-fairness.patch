+  constexpr uint64_t firstTag{0x7000000000000000ULL};
+  for (size_t i = 0; i < requestPairCount; ++i) {
+    send[i] = firstTag + i;
+    const ucxx::Tag tag{send[i]};
+    requests.push_back(worker->tagRecvBuilder(&receive[i], sizeof(receive[i]), tag, ucxx::TagMaskFull).build());
+    requests.push_back(establishedEndpoint->tagSendBuilder(&send[i], sizeof(send[i]), tag).build());
+  }
+
+  ProgressThreadStartGate startGate;
+  worker->setProgressThreadStartCallback(ProgressThreadStartGate::callback, &startGate);
+  worker->startProgressThread(true);
+
+  const bool progressThreadParked = startGate.waitUntilEntered(2s);
+  if (!progressThreadParked) {
+    startGate.release();
+    worker->stopProgressThread();
+    FAIL() << "progress thread did not enter its start gate";
+    return;
+  }
+
+  std::thread gateReleaser([&]() {
+    std::this_thread::sleep_for(25ms);
+    startGate.release();
+  });
+
+  std::shared_ptr<ucxx::Endpoint> lateEndpoint;
+  std::string endpointFailure;
+  const auto endpointStart = std::chrono::steady_clock::now();
+  try {
+    lateEndpoint = worker->endpointBuilder(address).endpointErrorHandling(false).build();
+  } catch (const std::exception& error) {
+    endpointFailure = error.what();
+  }
+  const auto endpointLatency = std::chrono::steady_clock::now() - endpointStart;
+  gateReleaser.join();
+
+  const size_t requestsCompletedWhenEndpointCompleted = std::count_if(
+    requests.begin(), requests.end(), [](const auto& request) { return request->isCompleted(); });
+  const bool backlogCompleted = waitUntil(drainTimeout, [&]() {
+    return std::all_of(
+      requests.begin(), requests.end(), [](const auto& request) { return request->isCompleted(); });
+  });
+
+  std::string transferFailure;
+  if (backlogCompleted) {
+    try {
+      for (const auto& request : requests)
+        request->checkError();
+      if (receive != send) transferFailure = "natural-backlog tag data did not match";
+    } catch (const std::exception& error) {
+      transferFailure = error.what();
+    }
+  }
+
+  const bool endpointCreated = lateEndpoint != nullptr;
+  lateEndpoint.reset();
+  establishedEndpoint.reset();
+  worker->stopProgressThread();
+
+  const auto endpointLatencyMs =
+    std::chrono::duration_cast<std::chrono::milliseconds>(endpointLatency).count();
+  RecordProperty("natural_request_pairs", std::to_string(requestPairCount));
+  RecordProperty("natural_delayed_requests", std::to_string(requestPairCount * 2));
+  RecordProperty("endpoint_latency_ms", std::to_string(endpointLatencyMs));
+  RecordProperty("requests_completed_when_endpoint_completed",
+                 std::to_string(requestsCompletedWhenEndpointCompleted));
+
+  EXPECT_TRUE(backlogCompleted);
+  EXPECT_TRUE(transferFailure.empty()) << transferFailure;
+  EXPECT_TRUE(endpointFailure.empty()) << endpointFailure;
+  EXPECT_TRUE(endpointCreated);
+  if (maxEndpointLatencyMs > 0)
+    EXPECT_LT(endpointLatencyMs, static_cast<int64_t>(maxEndpointLatencyMs));
+}
+
+TEST(WorkerProgressThreadTest, LateEndpointsCompleteDuringDelayedTagTraffic)
+{
+  const size_t batchSize     = readPositiveEnvironmentSize("UCXX_TEST_FAIRNESS_BATCH_SIZE", 512);
+  const size_t endpointCount = readPositiveEnvironmentSize("UCXX_TEST_FAIRNESS_ENDPOINT_COUNT", 32);
+  const size_t maxEndpointLatencyMs =
+    readPositiveEnvironmentSize("UCXX_TEST_FAIRNESS_MAX_ENDPOINT_LATENCY_MS", 2000);
+
+  auto context             = ucxx::contextBuilder(UCP_FEATURE_TAG | UCP_FEATURE_WAKEUP).build();
+  auto worker              = ucxx::workerBuilder(context).delayedSubmission(true).build();
+  auto address             = worker->addressBuilder().build();
+  auto establishedEndpoint = worker->endpointBuilder(address).endpointErrorHandling(false).build();
+
+  worker->startProgressThread(true);
+
+  std::atomic<bool> stopProducer{false};
+  std::atomic<bool> trafficWindowPublished{false};
+  std::atomic<size_t> transfersCompleted{0};
+  std::mutex failureMutex;
+  std::string producerFailure;
+
+  auto setProducerFailure = [&](std::string message) {
+    std::lock_guard<std::mutex> lock(failureMutex);
+    if (producerFailure.empty()) producerFailure = std::move(message);
+  };
+
+  std::thread producer([&]() {
+    struct TrafficSlot {
+      uint64_t send{0};
+      uint64_t receive{0};
+      std::shared_ptr<ucxx::Request> receiveRequest;
+      std::shared_ptr<ucxx::Request> sendRequest;
+    };
+
+    uint64_t nextTag{1};
+    try {
+      auto submit = [&](TrafficSlot& slot) {
+        slot.send    = nextTag++;
+        slot.receive = 0;
+        const ucxx::Tag tag{slot.send};
+        slot.receiveRequest =
+          worker->tagRecvBuilder(&slot.receive, sizeof(slot.receive), tag, ucxx::TagMaskFull).build();
+        slot.sendRequest = establishedEndpoint->tagSendBuilder(&slot.send, sizeof(slot.send), tag).build();
+      };
+
+      std::vector<TrafficSlot> slots(batchSize);
+      for (auto& slot : slots)
+        submit(slot);
+      trafficWindowPublished.store(true, std::memory_order_release);
+
+      while (!stopProducer.load(std::memory_order_acquire)) {
+        bool progressedSlot{false};
+        for (auto& slot : slots) {
+          if (!slot.receiveRequest->isCompleted() || !slot.sendRequest->isCompleted()) continue;
+
+          slot.receiveRequest->checkError();
+          slot.sendRequest->checkError();
+          if (slot.receive != slot.send)
+            throw std::runtime_error("background tag data did not match");
+
+          transfersCompleted.fetch_add(1, std::memory_order_release);
+          submit(slot);
+          progressedSlot = true;
+        }
+        if (!progressedSlot) std::this_thread::yield();
+      }
+
+      if (!waitUntil(20s, [&]() {
+            return std::all_of(slots.begin(), slots.end(), [](const auto& slot) {
+              return slot.receiveRequest->isCompleted() && slot.sendRequest->isCompleted();
+            });
+          }))
+        throw std::runtime_error("timed out draining the background traffic window");
+
+      for (const auto& slot : slots) {
+        slot.receiveRequest->checkError();
+        slot.sendRequest->checkError();
+        if (slot.receive != slot.send)
+          throw std::runtime_error("background tag data did not match while draining");
+      }
+      transfersCompleted.fetch_add(slots.size(), std::memory_order_release);
+    } catch (const std::exception& error) {
+      setProducerFailure(error.what());
+    } catch (...) {
+      setProducerFailure("unknown exception in background traffic producer");
+    }
+  });
+
+  const bool trafficStarted =
+    waitUntil(10s, [&]() { return trafficWindowPublished.load(std::memory_order_acquire); });
+
+  std::vector<std::shared_ptr<ucxx::Endpoint>> lateEndpoints;
+  lateEndpoints.reserve(endpointCount);
+  std::chrono::steady_clock::duration maxEndpointLatency{};
+  std::string endpointFailure;
+
+  if (trafficStarted) {
+    try {
+      for (size_t i = 0; i < endpointCount; ++i) {
+        const auto start   = std::chrono::steady_clock::now();
+        auto endpoint      = worker->endpointBuilder(address).endpointErrorHandling(false).build();
+        maxEndpointLatency = std::max(maxEndpointLatency, std::chrono::steady_clock::now() - start);
+        if (endpoint == nullptr) {
+          endpointFailure = "endpoint creation returned null";
+          break;
+        }
+        lateEndpoints.push_back(std::move(endpoint));
+      }
+    } catch (const std::exception& error) {
+      endpointFailure = error.what();
+    }
+  }
+
+  stopProducer.store(true, std::memory_order_release);
+  producer.join();
+
+  std::string transferFailure;
+  const size_t createdEndpointCount = lateEndpoints.size();
+  std::vector<std::shared_ptr<std::atomic<size_t>>> completionCounts;
+  if (endpointFailure.empty() && lateEndpoints.size() == endpointCount) {
+    try {
+      std::vector<uint64_t> send(endpointCount);
+      std::vector<uint64_t> receive(endpointCount, 0);
+      std::vector<std::shared_ptr<ucxx::Request>> requests;
+      requests.reserve(endpointCount * 2);
+      completionCounts.reserve(endpointCount * 2);
+
+      auto countCompletion = [](ucs_status_t, std::shared_ptr<void> data) {
+        std::static_pointer_cast<std::atomic<size_t>>(data)->fetch_add(1,
+                                                                       std::memory_order_relaxed);
+      };
+
+      for (size_t i = 0; i < endpointCount; ++i) {
+        send[i] = 0xf000000000000000ULL + i;
+        const ucxx::Tag tag{send[i]};
+        auto receiveCompletions = std::make_shared<std::atomic<size_t>>(0);
+        auto sendCompletions    = std::make_shared<std::atomic<size_t>>(0);
+        completionCounts.push_back(receiveCompletions);
+        completionCounts.push_back(sendCompletions);
+        requests.push_back(worker->tagRecvBuilder(&receive[i], sizeof(receive[i]), tag, ucxx::TagMaskFull)
+                             .pythonFuture(false)
+                             .callbackFunction(countCompletion)
+                             .callbackData(receiveCompletions)
+                             .build());
+        requests.push_back(lateEndpoints[i]->tagSendBuilder(&send[i], sizeof(send[i]), tag)
+                             .pythonFuture(false)
+                             .callbackFunction(countCompletion)
+                             .callbackData(sendCompletions)
+                             .build());
+      }
+
+      if (!waitUntil(10s, [&]() {
+            return std::all_of(requests.begin(), requests.end(), [](const auto& request) {
+              return request->isCompleted();
+            });
+          })) {
+        transferFailure = "timed out validating late endpoints";
+      } else {
+        for (const auto& request : requests)
+          request->checkError();
+        if (receive != send) transferFailure = "late-endpoint tag data did not match";
+        if (std::any_of(completionCounts.begin(), completionCounts.end(), [](const auto& count) {
+              return count->load(std::memory_order_relaxed) != 1;
+            }))
+          transferFailure = "a late-endpoint request callback did not run exactly once";
+      }
+    } catch (const std::exception& error) {
+      transferFailure = error.what();
+    }
+  }
+
+  lateEndpoints.clear();
+  establishedEndpoint.reset();
+  worker->stopProgressThread();
+
+  std::string producerFailureCopy;
+  {
+    std::lock_guard<std::mutex> lock(failureMutex);
+    producerFailureCopy = producerFailure;
+  }
+
+  EXPECT_TRUE(trafficStarted);
+  EXPECT_TRUE(endpointFailure.empty()) << endpointFailure;
+  EXPECT_EQ(createdEndpointCount, endpointCount);
+  EXPECT_TRUE(producerFailureCopy.empty()) << producerFailureCopy;
+  EXPECT_TRUE(transferFailure.empty()) << transferFailure;
+  EXPECT_GT(transfersCompleted.load(std::memory_order_acquire), 0);
+  const auto maxEndpointLatencyMilliseconds =
+    std::chrono::duration_cast<std::chrono::milliseconds>(maxEndpointLatency).count();
+  RecordProperty("background_transfers_completed",
+                 std::to_string(transfersCompleted.load(std::memory_order_acquire)));
+  RecordProperty("late_endpoints_created", std::to_string(createdEndpointCount));
+  RecordProperty("max_endpoint_latency_ms", std::to_string(maxEndpointLatencyMilliseconds));
+  if (createdEndpointCount > 0)
+    EXPECT_LT(maxEndpointLatencyMilliseconds, static_cast<int64_t>(maxEndpointLatencyMs));
+}
+
+}  // namespace
