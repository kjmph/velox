+class ProgressThreadStartGate {
+ private:
+  std::mutex _mutex;
+  std::condition_variable _conditionVariable;
+  bool _entered{false};
+  bool _released{false};
+
+ public:
+  static void callback(void* argument)
+  {
+    auto* gate = static_cast<ProgressThreadStartGate*>(argument);
+    std::unique_lock<std::mutex> lock(gate->_mutex);
+    gate->_entered = true;
+    gate->_conditionVariable.notify_all();
+    gate->_conditionVariable.wait(lock, [&]() { return gate->_released; });
+  }
+
+  bool waitUntilEntered(std::chrono::milliseconds timeout)
+  {
+    std::unique_lock<std::mutex> lock(_mutex);
+    return _conditionVariable.wait_for(lock, timeout, [&]() { return _entered; });
+  }
+
+  void release()
+  {
+    {
+      std::lock_guard<std::mutex> lock(_mutex);
+      _released = true;
+    }
+    _conditionVariable.notify_all();
+  }
+};
+
+void enqueueDelayedRequestBacklog(const std::shared_ptr<ucxx::Worker>& worker,
+                                  size_t requestCount,
+                                  std::chrono::microseconds callbackDelay,
+                                  std::atomic<size_t>& requestsProcessed)
+{
+  for (size_t i = 0; i < requestCount; ++i) {
+    // The worker only needs the Request shared pointer to preserve its lifetime.
+    // An empty pointer is sufficient for this scheduling-only test, while the
+    // callback models the work performed by Request::populateDelayedSubmission().
+    worker->registerDelayedSubmission({}, [callbackDelay, &requestsProcessed]() {
+      if (callbackDelay.count() > 0) std::this_thread::sleep_for(callbackDelay);
+      requestsProcessed.fetch_add(1, std::memory_order_release);
+    });
+  }
+}
