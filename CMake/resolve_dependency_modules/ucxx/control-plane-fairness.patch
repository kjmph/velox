diff --git a/cpp/include/ucxx/utils/progress.h b/cpp/include/ucxx/utils/progress.h
new file mode 100644
index 0000000..88d2f37
--- /dev/null
+++ b/cpp/include/ucxx/utils/progress.h
@@ -0,0 +1,57 @@
+/**
+ * SPDX-FileCopyrightText: Copyright (c) 2026, NVIDIA CORPORATION & AFFILIATES.
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+#pragma once
+
+#include <cstddef>
+
+namespace ucxx::utils {
+
+/**
+ * Maximum number of consecutive UCP progress calls made by one UCXX progress
+ * operation.
+ *
+ * A progress thread also owns delayed request submission and generic control
+ * callbacks. Returning to its outer scheduling loop after a finite amount of
+ * data-plane work prevents continuously busy UCP workers from starving those
+ * queues.
+ */
+inline constexpr size_t kDefaultProgressDrainMaxIterations = 256;
+
+/**
+ * Result from a bounded progress drain.
+ */
+struct ProgressDrainResult {
+  bool madeProgress{false};  ///< At least one progress call reported work.
+  bool reachedIdle{false};   ///< A progress call reported that no work remained.
+  size_t iterations{0};      ///< Number of progress calls made.
+};
+
+/**
+ * Progress until the worker reports idle or the fairness budget is exhausted.
+ *
+ * @param[in] progressOnce  callable returning true when it progressed work.
+ * @param[in] maxIterations maximum number of calls before yielding.
+ *
+ * @returns drain status, including whether the worker reached idle.
+ */
+template <typename ProgressOnce>
+ProgressDrainResult progressUntilIdleOrBudget(
+  ProgressOnce&& progressOnce, size_t maxIterations = kDefaultProgressDrainMaxIterations)
+{
+  ProgressDrainResult result{};
+
+  for (size_t i = 0; i < maxIterations; ++i) {
+    ++result.iterations;
+    if (!progressOnce()) {
+      result.reachedIdle = true;
+      break;
+    }
+    result.madeProgress = true;
+  }
+
+  return result;
+}
+
+}  // namespace ucxx::utils
