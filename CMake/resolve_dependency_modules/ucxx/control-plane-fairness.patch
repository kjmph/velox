+TEST(WorkerProgressThreadTest, DISABLED_ReportsLateEndpointLatencyUnderNaturalTagBacklog)
+{
+  const size_t requestPairCount =
+    readPositiveEnvironmentSize("UCXX_TEST_NATURAL_BACKLOG_REQUEST_PAIRS", 32768);
+  const auto drainTimeout = std::chrono::milliseconds{
+    readPositiveEnvironmentSize("UCXX_TEST_NATURAL_BACKLOG_DRAIN_TIMEOUT_MS", 60000)};
+  const size_t maxEndpointLatencyMs =
+    readPositiveEnvironmentSize("UCXX_TEST_NATURAL_BACKLOG_MAX_ENDPOINT_LATENCY_MS", 0);
+
+  auto context             = ucxx::contextBuilder(UCP_FEATURE_TAG | UCP_FEATURE_WAKEUP).build();
+  auto worker              = ucxx::workerBuilder(context).delayedSubmission(true).build();
+  auto address             = worker->addressBuilder().build();
+  auto establishedEndpoint = worker->endpointBuilder(address).endpointErrorHandling(false).build();
+
+  std::vector<uint64_t> send(requestPairCount);
+  std::vector<uint64_t> receive(requestPairCount, 0);
+  std::vector<std::shared_ptr<ucxx::Request>> requests;
+  requests.reserve(requestPairCount * 2);
