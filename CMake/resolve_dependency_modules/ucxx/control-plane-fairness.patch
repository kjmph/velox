+#!/usr/bin/env bash
+# SPDX-FileCopyrightText: Copyright (c) 2026, NVIDIA CORPORATION & AFFILIATES.
+# SPDX-License-Identifier: BSD-3-Clause
+
+set -euo pipefail
+
+script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+repo_root="$(cd -- "${script_dir}/../.." && pwd)"
+
+mode="${1:-fast}"
+test_binary="${2:-${repo_root}/cpp/build/gtests/UCXX_TEST}"
+timeout_command="${TIMEOUT_COMMAND:-timeout}"
+
+if [[ ! -x "${test_binary}" ]]; then
+  echo "UCXX test binary is missing or not executable: ${test_binary}" >&2
+  echo "Build it first with: ./build.sh clean libucxx libucxx_tests -n" >&2
+  exit 2
+fi
+
+case "${mode}" in
+  fast)
+    exec "${timeout_command}" 90s "${test_binary}" \
+      --gtest_filter='ProgressDrainTest.*:DelayedSubmissionBacklogTest.*:WorkerProgressThreadTest.GenericPreRunsWhileProgressRemainsContinuouslyBusy:WorkerProgressThreadTest.LateEndpointsCompleteDuringDelayedTagTraffic' \
+      --gtest_break_on_failure
+    ;;
+
+  backlog-repro)
+    export UCXX_TEST_BACKLOG_REQUEST_COUNT="${UCXX_TEST_BACKLOG_REQUEST_COUNT:-128}"
+    export UCXX_TEST_BACKLOG_CALLBACK_DELAY_US="${UCXX_TEST_BACKLOG_CALLBACK_DELAY_US:-2000}"
+    export UCXX_TEST_BACKLOG_CONTROL_DEADLINE_MS="${UCXX_TEST_BACKLOG_CONTROL_DEADLINE_MS:-100}"
+
+    exec "${timeout_command}" 30s "${test_binary}" \
+      --gtest_filter='WorkerProgressThreadTest.DISABLED_ControlPreMeetsDeadlineUnderDelayedRequestBacklog' \
+      --gtest_also_run_disabled_tests
+    ;;
+
+  endpoint-repro)
+    export UCXX_TEST_ENDPOINT_BACKLOG_REQUEST_COUNT="${UCXX_TEST_ENDPOINT_BACKLOG_REQUEST_COUNT:-400}"
+    export UCXX_TEST_ENDPOINT_BACKLOG_CALLBACK_DELAY_US="${UCXX_TEST_ENDPOINT_BACKLOG_CALLBACK_DELAY_US:-10000}"
+    export UCXX_TEST_ENDPOINT_BACKLOG_MAX_LATENCY_MS="${UCXX_TEST_ENDPOINT_BACKLOG_MAX_LATENCY_MS:-2000}"
+
+    exec "${timeout_command}" 30s "${test_binary}" \
+      --gtest_filter='WorkerProgressThreadTest.DISABLED_LateEndpointMeetsDeadlineUnderDelayedRequestBacklog' \
+      --gtest_also_run_disabled_tests
+    ;;
+
+  natural-backlog)
+    natural_backlog_counts="${UCXX_TEST_NATURAL_BACKLOG_COUNTS:-8192 32768 131072}"
+    for request_pairs in ${natural_backlog_counts}; do
+      echo "Natural delayed-request backlog: ${request_pairs} tag request pairs"
+      UCXX_TEST_NATURAL_BACKLOG_REQUEST_PAIRS="${request_pairs}" \
+        "${timeout_command}" 120s "${test_binary}" \
+          --gtest_filter='WorkerProgressThreadTest.DISABLED_ReportsLateEndpointLatencyUnderNaturalTagBacklog' \
+          --gtest_also_run_disabled_tests
+    done
+    ;;
+
+  stress)
+    export UCXX_TEST_FAIRNESS_BATCH_SIZE="${UCXX_TEST_FAIRNESS_BATCH_SIZE:-32768}"
+    export UCXX_TEST_FAIRNESS_ENDPOINT_COUNT="${UCXX_TEST_FAIRNESS_ENDPOINT_COUNT:-256}"
+    export UCXX_TEST_FAIRNESS_MAX_ENDPOINT_LATENCY_MS="${UCXX_TEST_FAIRNESS_MAX_ENDPOINT_LATENCY_MS:-2000}"
+    gtest_repeat="${GTEST_REPEAT:-10}"
+
+    exec "${timeout_command}" 300s "${test_binary}" \
+      --gtest_filter='WorkerProgressThreadTest.LateEndpointsCompleteDuringDelayedTagTraffic' \
+      "--gtest_repeat=${gtest_repeat}" \
+      --gtest_break_on_failure
+    ;;
+
+  *)
+    echo "Usage: $0 [fast|backlog-repro|endpoint-repro|natural-backlog|stress] [path/to/UCXX_TEST]" >&2
+    exit 2
+    ;;
+esac
