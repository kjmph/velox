+TEST(WorkerProgressThreadTest, GenericPreRunsWhileProgressRemainsContinuouslyBusy)
+{
+  constexpr auto callbackDeadline = 500ms;
+  auto delayedSubmissions         = std::make_shared<ucxx::DelayedSubmissionCollection>(false);
+
+  std::atomic<bool> keepProgressBusy{true};
+  std::atomic<size_t> progressCalls{0};
+  std::mutex mutex;
+  std::condition_variable conditionVariable;
+  bool callbackRan{false};
+
+  ucxx::WorkerProgressThread progressThread(
+    true,
+    [&]() {
+      return ucxx::utils::progressUntilIdleOrBudget([&]() {
+               const auto calls = progressCalls.fetch_add(1, std::memory_order_relaxed) + 1;
+               if (calls == ucxx::utils::kDefaultProgressDrainMaxIterations)
+                 conditionVariable.notify_all();
+               return keepProgressBusy.load(std::memory_order_acquire);
+             })
+        .madeProgress;
+    },
+    []() {},
+    []() {},
+    nullptr,
+    nullptr,
+    delayedSubmissions);
+
+  bool progressBecameBusy{false};
+  {
+    std::unique_lock<std::mutex> lock(mutex);
+    progressBecameBusy = conditionVariable.wait_for(lock, 1s, [&]() {
+      return progressCalls.load(std::memory_order_relaxed) >=
+             ucxx::utils::kDefaultProgressDrainMaxIterations;
+    });
+  }
+
+  if (progressBecameBusy) {
+    std::ignore = delayedSubmissions->registerGenericPre([&]() {
+      {
+        std::lock_guard<std::mutex> lock(mutex);
+        callbackRan = true;
+      }
+      conditionVariable.notify_all();
+    });
+  }
+
+  bool callbackRanWithinDeadline{false};
+  {
+    std::unique_lock<std::mutex> lock(mutex);
+    callbackRanWithinDeadline =
+      conditionVariable.wait_for(lock, callbackDeadline, [&]() { return callbackRan; });
+  }
+
+  // Always release a deliberately unbounded implementation before joining the
+  // progress thread. This makes the regression fail instead of hanging the test.
+  keepProgressBusy.store(false, std::memory_order_release);
+  conditionVariable.notify_all();
+  progressThread.stop();
+
+  EXPECT_TRUE(progressBecameBusy);
+  EXPECT_TRUE(callbackRanWithinDeadline);
+  EXPECT_GT(progressCalls.load(std::memory_order_relaxed),
+            ucxx::utils::kDefaultProgressDrainMaxIterations);
+}
