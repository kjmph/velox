+TEST(WorkerProgressThreadTest, DISABLED_ControlPreMeetsDeadlineUnderDelayedRequestBacklog)
+{
+  const size_t requestCount = readPositiveEnvironmentSize("UCXX_TEST_BACKLOG_REQUEST_COUNT", 128);
+  const auto callbackDelay  = std::chrono::microseconds{
+    readPositiveEnvironmentSize("UCXX_TEST_BACKLOG_CALLBACK_DELAY_US", 2000)};
+  const auto callbackDeadline = std::chrono::milliseconds{
+    readPositiveEnvironmentSize("UCXX_TEST_BACKLOG_CONTROL_DEADLINE_MS", 100)};
+
+  auto context = ucxx::contextBuilder(UCP_FEATURE_TAG | UCP_FEATURE_WAKEUP).build();
+  auto worker  = ucxx::workerBuilder(context).delayedSubmission(true).build();
+
+  std::atomic<size_t> requestsProcessed{0};
+  std::atomic<size_t> requestsSeenByControlPre{0};
+  std::atomic<bool> controlPreRan{false};
+  enqueueDelayedRequestBacklog(worker, requestCount, callbackDelay, requestsProcessed);
+
+  ProgressThreadStartGate startGate;
+  worker->setProgressThreadStartCallback(ProgressThreadStartGate::callback, &startGate);
+  worker->startProgressThread(true);
+
+  const bool progressThreadParked = startGate.waitUntilEntered(2s);
+  if (!progressThreadParked) {
+    startGate.release();
+    worker->stopProgressThread();
+    FAIL() << "progress thread did not enter its start gate";
+    return;
+  }
+
+  // Give registerControlPre() time to enqueue its callback before allowing the
+  // progress thread to take its first delayed-request snapshot.
+  std::thread gateReleaser([&]() {
+    std::this_thread::sleep_for(25ms);
+    startGate.release();
+  });
+
+  const auto callbackStart     = std::chrono::steady_clock::now();
+  const bool callbackCompleted = worker->registerControlPre(
+    [&]() {
+      requestsSeenByControlPre.store(requestsProcessed.load(std::memory_order_acquire),
+                                     std::memory_order_release);
+      controlPreRan.store(true, std::memory_order_release);
+    },
+    std::chrono::duration_cast<std::chrono::nanoseconds>(callbackDeadline).count());
+  const auto callbackLatency                  = std::chrono::steady_clock::now() - callbackStart;
+  const auto requestsProcessedAtControlReturn = requestsProcessed.load(std::memory_order_acquire);
+  gateReleaser.join();
+
+  const auto backlogDrainTimeout =
+    std::chrono::duration_cast<std::chrono::milliseconds>(callbackDelay * requestCount) + 5s;
+  const bool backlogDrained = waitUntil(backlogDrainTimeout, [&]() {
+    return requestsProcessed.load(std::memory_order_acquire) == requestCount;
+  });
+  worker->stopProgressThread();
+
+  const auto callbackLatencyMs =
+    std::chrono::duration_cast<std::chrono::milliseconds>(callbackLatency).count();
+  RecordProperty("delayed_request_count", std::to_string(requestCount));
+  RecordProperty("delayed_request_callback_us", std::to_string(callbackDelay.count()));
+  RecordProperty("control_deadline_ms", std::to_string(callbackDeadline.count()));
+  RecordProperty("control_callback_latency_ms", std::to_string(callbackLatencyMs));
+  RecordProperty("requests_processed_at_control_return",
+                 std::to_string(requestsProcessedAtControlReturn));
+  RecordProperty("requests_processed_before_control_pre",
+                 std::to_string(requestsSeenByControlPre.load(std::memory_order_acquire)));
+
+  EXPECT_TRUE(backlogDrained);
+  EXPECT_TRUE(callbackCompleted)
+    << "control-pre callback timed out behind the delayed-request snapshot";
+  EXPECT_TRUE(controlPreRan.load(std::memory_order_acquire));
+  EXPECT_LT(callbackLatency, callbackDeadline);
+}
+
+TEST(WorkerProgressThreadTest, DISABLED_LateEndpointMeetsDeadlineUnderDelayedRequestBacklog)
+{
+  const size_t requestCount =
+    readPositiveEnvironmentSize("UCXX_TEST_ENDPOINT_BACKLOG_REQUEST_COUNT", 400);
+  const auto callbackDelay = std::chrono::microseconds{
+    readPositiveEnvironmentSize("UCXX_TEST_ENDPOINT_BACKLOG_CALLBACK_DELAY_US", 10000)};
+  const auto maxEndpointLatency = std::chrono::milliseconds{
+    readPositiveEnvironmentSize("UCXX_TEST_ENDPOINT_BACKLOG_MAX_LATENCY_MS", 2000)};
+
+  auto context = ucxx::contextBuilder(UCP_FEATURE_TAG | UCP_FEATURE_WAKEUP).build();
+  auto worker  = ucxx::workerBuilder(context).delayedSubmission(true).build();
+  auto address = worker->addressBuilder().build();
+
+  std::atomic<size_t> requestsProcessed{0};
+  std::mutex firstRequestMutex;
+  std::condition_variable firstRequestConditionVariable;
+  bool firstRequestStarted{false};
+  bool releaseFirstRequest{false};
+  for (size_t i = 0; i < requestCount; ++i) {
+    worker->registerDelayedSubmission({}, [&, i]() {
+      if (i == 0) {
+        std::unique_lock<std::mutex> lock(firstRequestMutex);
+        firstRequestStarted = true;
+        firstRequestConditionVariable.notify_all();
+        firstRequestConditionVariable.wait(lock, [&]() { return releaseFirstRequest; });
+      }
+      if (callbackDelay.count() > 0) std::this_thread::sleep_for(callbackDelay);
+      requestsProcessed.fetch_add(1, std::memory_order_release);
+    });
+  }
+
+  worker->startProgressThread(true);
+
+  bool requestProcessingStarted{false};
+  {
+    std::unique_lock<std::mutex> lock(firstRequestMutex);
+    requestProcessingStarted =
+      firstRequestConditionVariable.wait_for(lock, 2s, [&]() { return firstRequestStarted; });
+  }
+  if (!requestProcessingStarted) {
+    {
+      std::lock_guard<std::mutex> lock(firstRequestMutex);
+      releaseFirstRequest = true;
+    }
+    firstRequestConditionVariable.notify_all();
+    worker->stopProgressThread();
+    FAIL() << "progress thread did not begin processing the request snapshot";
+    return;
+  }
+
+  // Endpoint creation is queued while the progress thread is inside the first
+  // request chunk, matching the production arrival pattern rather than placing
+  // control work ahead of the snapshot.
+  std::thread firstRequestReleaser([&]() {
+    std::this_thread::sleep_for(25ms);
+    {
+      std::lock_guard<std::mutex> lock(firstRequestMutex);
+      releaseFirstRequest = true;
+    }
+    firstRequestConditionVariable.notify_all();
+  });
+
+  std::shared_ptr<ucxx::Endpoint> endpoint;
+  std::string endpointFailure;
+  const auto endpointStart = std::chrono::steady_clock::now();
+  try {
+    endpoint = worker->endpointBuilder(address).endpointErrorHandling(false).build();
+  } catch (const std::exception& error) {
+    endpointFailure = error.what();
+  }
+  const auto endpointLatency = std::chrono::steady_clock::now() - endpointStart;
+  const auto requestsProcessedWhenEndpointCompleted =
+    requestsProcessed.load(std::memory_order_acquire);
+  firstRequestReleaser.join();
+
+  const auto backlogDrainTimeout =
+    std::chrono::duration_cast<std::chrono::milliseconds>(callbackDelay * requestCount) + 5s;
+  const bool backlogDrained = waitUntil(backlogDrainTimeout, [&]() {
+    return requestsProcessed.load(std::memory_order_acquire) == requestCount;
+  });
+
+  const bool endpointCreated = endpoint != nullptr;
+  endpoint.reset();
+  worker->stopProgressThread();
+
+  const auto endpointLatencyMs =
+    std::chrono::duration_cast<std::chrono::milliseconds>(endpointLatency).count();
+  RecordProperty("delayed_request_count", std::to_string(requestCount));
+  RecordProperty("delayed_request_callback_us", std::to_string(callbackDelay.count()));
+  RecordProperty("endpoint_max_latency_ms", std::to_string(maxEndpointLatency.count()));
+  RecordProperty("endpoint_latency_ms", std::to_string(endpointLatencyMs));
+  RecordProperty("requests_processed_when_endpoint_completed",
+                 std::to_string(requestsProcessedWhenEndpointCompleted));
+
+  EXPECT_TRUE(backlogDrained);
+  EXPECT_TRUE(endpointFailure.empty()) << endpointFailure;
+  EXPECT_TRUE(endpointCreated);
+  EXPECT_LT(endpointLatency, maxEndpointLatency)
+    << "ucp_ep_create was delayed behind the delayed-request snapshot";
+}
